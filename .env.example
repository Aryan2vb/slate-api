ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://slate:slate@localhost:5432/slate

# Supabase Auth (enable the Google provider in the Supabase dashboard). Tokens are verified via JWKS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
STORAGE_BUCKET=meeting-audio

# Speech-to-text: deepgram | groq | fake
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# LLM: groq (free tier) | anthropic | openai-compatible | fake
LLM_PROVIDER=groq
LLM_MODEL=
# openai-compatible only
LLM_BASE_URL=
LLM_API_KEY=
ANTHROPIC_API_KEY=

RUN_WORKER_IN_PROCESS=true

# Per-user limits per rolling hour on endpoints that spend provider credit
RATE_LIMIT_PROCESSING_PER_HOUR=30
RATE_LIMIT_CATCHUP_PER_HOUR=60

# Browser origins allowed to call the API (JSON list), e.g. the local Slate Console
CORS_ORIGINS=["http://localhost:5173"]
